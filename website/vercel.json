{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/api/:path/:rest",
      "destination": "https://unearth-1o4a.onrender.com/:path/:rest"
    },
    {
      "source": "/api/:path",
      "destination": "https://unearth-1o4a.onrender.com/:path"
    },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/search", "destination": "/index.html" },
    { "source": "/g/:slug", "destination": "/api/page" },
    { "source": "/u/:handle", "destination": "/api/page" },
    { "source": "/lists/:city/:kind", "destination": "/api/page" },
    { "source": "/:city/:area/:category", "destination": "/api/page" },
    { "source": "/:city/:area", "destination": "/api/page" },
    { "source": "/:city", "destination": "/api/page" },
    { "source": "/{*path}", "destination": "/index.html" }
  ],
  "functions": {
    "api/page.ts": { "includeFiles": "dist/index.html" },
    "api/og/[...path].tsx": { "includeFiles": "api/_fonts/**" },
    "api/sitemap.ts": {}
  }
}
